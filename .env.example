APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://fraudlens:fraudlens_dev@localhost:5432/fraudlens
API_KEY_HASH_PEPPER=replace-with-a-development-only-value
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=65536
IDEMPOTENCY_TTL_SECONDS=86400
RISK_MODE_DEFAULT=shadow
MODEL_ARTIFACT_PATH=
RETENTION_TRANSACTION_DAYS=30
RETENTION_AUDIT_DAYS=365
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_SECONDS=2
WEBHOOK_MAX_ATTEMPTS=5

# Docker Compose values. Do not use these development credentials elsewhere.
POSTGRES_DB=fraudlens
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=fraudlens_dev
POSTGRES_HOST_PORT=5432
